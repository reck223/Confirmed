{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 20 * * 0"
    },
    {
      "path": "/api/cron/streak-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/stale-goals",
      "schedule": "0 15 * * *"
    }
  ]
}
